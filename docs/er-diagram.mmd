    FIELDS {
        uuid id PK                          "auto"
        text nop UK                         "35.05.050.005.{blok}.{no_bidang}  —  gabung SPOP col 3-8"
        text no_urut UK                     "{blok}{no_bidang}  —  join key ke LSPOP"
        text owner_name                     "SPOP col 13  —  1325 unique, 43pct multi-plot"
        text owner_address                  "SPOP col 14-18  —  concat jalan/RW/RT/desa/kab"
        text address                        "SPOP col 19  —  RAW, variasi tulisan tinggi"
        text rw                             "SPOP col 20  —  281 null"
        text rt                             "SPOP col 21  —  281 null"
        text blok                           "SPOP col 7  —  001-013, 3 digit"
        text dusun                          "derived  —  001-005=Tulungrejo, 006-012=Sidodadi, 013=TumpakGatho"
        numeric land_area                   "SPOP col 22  —  ROUND(val,2), 190 baris floating error"
        numeric building_area               "LSPOP col 16  —  SUM per no_urut, null jika tanpa bangunan"
        int building_count                  "LSPOP COUNT per no_urut, null jika tanpa bangunan"
        text znt                            "SPOP col 23  —  21 kode zona: AA-AU"
        int jenis_tanah                     "SPOP col 24  —  1=sawah, 3=kering, 4=lain"
        date pendataan_at                   "SPOP col 26  —  FULL date, 35 unique, 2016-09 s.d 2016-10"
        timestamptz created_at              "auto"
        timestamptz updated_at              "auto"
    }

