generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model RateLimit {
  id        String   @id
  count     Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("rate_limits")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(pamong_pajak)
  tokenVersion Int      @default(0) @map("token_version")
  assignedBlok   String?   @map("assigned_blok")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  markedPayments Payments[]
  articles       Article[]

  @@map("users")
}

enum Role {
  kepala_desa
  pamong_pajak
  jurnalis
}

enum PaymentStatus {
  lunas
  belum_lunas
}

model VillageStats {
  id             Int      @id @default(autoincrement())
  jumlahKK       Int      @default(0) @map("jumlah_kk")
  jumlahPenduduk Int      @default(0) @map("jumlah_penduduk")
  lakiLaki       Int      @default(0) @map("laki_laki")
  perempuan      Int      @default(0) @map("perempuan")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("village_stats")
}

model VillageProfile {
  id                 Int      @id @default(autoincrement())
  visi               String   @default("")
  misi               String   @db.Text @default("[]")
  strukturOrganisasi       String   @db.Text @default("[]")
  strukturOrganisasiImage String?  @db.MediumText
  tugasFungsi              String   @db.Text @default("[]")
  administratif      String   @db.Text @default("{}")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("village_profile")
}

model Fields {
  id            String    @id @default(uuid())
  nop           String    @unique
  noUrut        String    @unique @map("no_urut")
  ownerName     String    @map("owner_name")
  ownerAddress  String?   @map("owner_address")
  address       String
  rw            String?
  rt            String?
  blok          String
  noBidang      String    @map("no_bidang")
  dusun         String
  landArea      Decimal?  @map("land_area") @db.Decimal(10, 2)
  buildingArea  Decimal?  @map("building_area") @db.Decimal(10, 2)
  buildingCount Int?      @map("building_count")
  znt           String?
  jenisTanah    Int?      @map("jenis_tanah")
  pendataanAt   DateTime? @map("pendataan_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  payments      Payments[]

  @@unique([blok, noBidang])
  @@index([dusun])
  @@map("fields")
}

model Payments {
  id        String   @id @default(uuid())
  fieldId   String   @map("field_id")
  field     Fields   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  year      Int
  status    PaymentStatus @default(belum_lunas)
  markedBy  Int?     @map("marked_by")
  marker    User?    @relation(fields: [markedBy], references: [id], onDelete: SetNull)
  markedAt  DateTime? @map("marked_at")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fieldId, year])
  @@index([year, status])
  @@map("payments")
}

model Realisasi {
  id           String   @id @default(uuid())
  kodeKec      String   @map("kode_kec")
  kecamatan    String
  kodeDesa     String   @map("kode_desa")
  desa         String
  totalPbb     BigInt   @map("total_pbb")
  totalBayar   BigInt   @map("total_bayar")
  persen       Decimal  @db.Decimal(5, 2)
  kurangBayar  BigInt   @map("kurang_bayar")
  totalSppt    Int      @map("total_sppt")
  dibayar      Int
  sisaSppt     Int      @map("sisa_sppt")
  tanggalAmbil DateTime @map("tanggal_ambil")
  tahun        Int
  importedAt   DateTime @default(now()) @map("imported_at")

  @@unique([kodeDesa, tahun])
  @@index([importedAt])
  @@map("realisasi")
}

model BlockImage {
  id       String @id @default(uuid())
  blok     String
  subBlok  String @map("sub_blok")
  image    String @db.MediumText
  mimeType String @map("mime_type")

  @@unique([blok, subBlok])
  @@map("block_images")
}

model ContactInfo {
  id          Int      @id @default(autoincrement())
  address     String   @default("")
  phone       String   @default("")
  email       String   @default("")
  jamKerja    String   @default("") @map("jam_kerja")
  jamLibur    String   @default("") @map("jam_libur")
  socialMedia String   @db.Text   // JSON array of {platform, url}
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contact_info")
}

model HomepageContent {
  id        Int      @id @default(autoincrement())
  heroTitle String   @default("") @map("hero_title")
  heroSubtitle String @default("") @map("hero_subtitle")
  heroDescription String @default("") @map("hero_description")
  aboutTitle     String   @default("") @map("about_title")
  aboutParagraphs String  @db.Text   // JSON array of strings
  googleMapsUrl  String   @db.Text @map("google_maps_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("homepage_content")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  date      DateTime
  author    String
  authorId  Int?    @map("author_id")
  createdBy User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category  String
  summary   String
  image     String? @db.MediumText
  content   String   @db.Text
  tags      String?  // JSON array
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([published, date])
  @@index([category])
  @@map("articles")
}
