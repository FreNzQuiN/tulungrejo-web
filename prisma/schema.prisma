generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model RateLimit {
  id        String   @id
  count     Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("rate_limits")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(pamong_pajak)
  assignedBlok String?  @map("assigned_blok")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum Role {
  kepala_desa
  pamong_pajak
  jurnalis
}

model VillageStats {
  id             Int      @id @default(autoincrement())
  jumlahKK       Int      @default(0) @map("jumlah_kk")
  jumlahPenduduk Int      @default(0) @map("jumlah_penduduk")
  lakiLaki       Int      @default(0) @map("laki_laki")
  perempuan      Int      @default(0) @map("perempuan")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("village_stats")
}

model VillageProfile {
  id                 Int      @id @default(autoincrement())
  visi               String   @default("")
  misi               String   @db.Text                    // JSON array of strings, default "[]" handled in app
  strukturOrganisasi String   @db.Text                    // JSON array of {role, name}, default "[]" handled in app
  tugasFungsi        String   @db.Text                    // JSON array of {jabatan, tugas}, default "[]" handled in app
  administratif      String   @db.Text                    // JSON object, default "{}" handled in app
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("village_profile")
}

model Fields {
  id            String    @id @default(uuid())
  nop           String    @unique
  noUrut        String    @unique @map("no_urut")
  ownerName     String    @map("owner_name")
  ownerAddress  String?   @map("owner_address")
  address       String
  rw            String?
  rt            String?
  blok          String
  noBidang      String    @map("no_bidang")
  dusun         String
  landArea      Decimal?  @map("land_area") @db.Decimal(10, 2)
  buildingArea  Decimal?  @map("building_area") @db.Decimal(10, 2)
  buildingCount Int?      @map("building_count")
  znt           String?
  jenisTanah    Int?      @map("jenis_tanah")
  pendataanAt   DateTime? @map("pendataan_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([blok, noBidang])
  @@map("fields")
}

model Payments {
  id        String   @id @default(uuid())
  fieldId   String   @map("field_id")
  year      Int
  status    String   @default("belum_lunas")
  markedBy  Int?     @map("marked_by")
  markedAt  DateTime? @map("marked_at")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fieldId, year])
  @@map("payments")
}

model Realisasi {
  id           String   @id @default(uuid())
  kodeKec      String   @map("kode_kec")
  kecamatan    String
  kodeDesa     String   @map("kode_desa")
  desa         String
  totalPbb     BigInt   @map("total_pbb")
  totalBayar   BigInt   @map("total_bayar")
  persen       Decimal  @db.Decimal(5, 2)
  kurangBayar  BigInt   @map("kurang_bayar")
  totalSppt    Int      @map("total_sppt")
  dibayar      Int
  sisaSppt     Int      @map("sisa_sppt")
  tanggalAmbil DateTime @map("tanggal_ambil")
  importedAt   DateTime @default(now()) @map("imported_at")

  @@map("realisasi")
}

model BlockImage {
  id       String @id @default(uuid())
  blok     String
  subBlok  String @map("sub_blok")
  image    String @db.MediumText
  mimeType String @map("mime_type")

  @@unique([blok, subBlok])
  @@map("block_images")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  date      DateTime
  author    String
  category  String
  summary   String
  image     String? @db.MediumText
  content   String   @db.Text
  tags      String?  // JSON array
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}
