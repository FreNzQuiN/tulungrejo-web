# Database
DATABASE_URL="mysql://user:password@host:port/db"

# Auth
JWT_SECRET="generate with: openssl rand -base64 32"
# AUTH_SECRET — fallback secret used when JWT_SECRET is not set
AUTH_SECRET="generate with: openssl rand -base64 32"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Environment
# NODE_ENV — controls runtime behavior (development/production)
NODE_ENV="development"

# Database pool
# DB_POOL_SIZE — maximum connections in the Prisma connection pool (default: 10)
DB_POOL_SIZE=10

# CORS
# ALLOWED_DEV_ORIGINS — comma-separated origins allowed during development
ALLOWED_DEV_ORIGINS="http://localhost:3000,http://localhost:5173"

# TiDB TLS — only needed on Windows (Linux/Mac/Netlify use system trust store)
# Generate: openssl base64 -in isrgrootx1.pem -A
# SSL_CA_BUNDLE_B64="<base64-of-isrg-root-x1>"
# SSL_CA_PATH — alternative: file path to the CA certificate bundle
# SSL_CA_PATH="/etc/ssl/certs/isrg-root-x1.pem"

# PBB Tax Year Transition
# PBB_TAX_YEAR_TRANSITION — cutoff date (MM-DD) for tax year rollover. After this date,
# new PBB records use the next year. Example: "06-01" means June 1st.
PBB_TAX_YEAR_TRANSITION="06-01"
