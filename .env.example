# ── Database ──
# TiDB Cloud (MySQL) via PrismaMariaDb adapter
DATABASE_URL="mysql://user:password@host:port/db"

# ── Auth ──
# JWT signing secret — minimal 32 karakter
# Generate: openssl rand -base64 32
JWT_SECRET=""
# AUTH_SECRET — fallback jika JWT_SECRET tidak diset
# AUTH_SECRET=""

# ── Site ──
# URL publik — dipakai untuk server-side fetch dan SEO
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database Pool ──
# Maksimum koneksi di Prisma connection pool (default: 10)
# DB_POOL_SIZE=10

# ── CORS ──
# Origin tambahan yang diizinkan saat development (comma-separated)
# ALLOWED_DEV_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── TiDB TLS ──
# Hanya diperlukan di Windows (Linux/Mac/Netlify pakai system trust store)
# Generate: openssl base64 -in isrgrootx1.pem -A
# SSL_CA_BUNDLE_B64="<base64-of-isrg-root-x1>"
# SSL_CA_PATH="/etc/ssl/certs/isrg-root-x1.pem"

# ── PBB Tax Year ──
# Cutoff date (MM-DD) untuk rollover tahun pajak.
# Setelah tanggal ini, record PBB baru menggunakan tahun berikutnya.
PBB_TAX_YEAR_TRANSITION="06-01"

# ── Seed Passwords ──
# Override password default seed user.
# Jika tidak diset, seed fallback ke: pamong123 / kades123 / jurnalis123
# SEED_PAMONG_PASSWORD=""
# SEED_KADES_PASSWORD=""
# SEED_JURNALIS_PASSWORD=""
